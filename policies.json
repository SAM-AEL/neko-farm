    "PromptForDownloadLocation": false,
    "SanitizeOnShutdown": {
      "Cache": false,
      "Cookies": false,
      "Downloads": false,
      "FormData": false,
      "History": false,
      "OfflineApps": false,
      "Sessions": false,
      "SiteSettings": false
