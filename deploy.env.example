# Target VPS for `yarn deploy`. Copy to deploy.env and fill in.
# Gitignored — safe to keep real hostnames/IPs out of the repo.

# Public IP or hostname of the VPS.
DEPLOY_HOST=

# SSH user (usually root on a fresh VPS).
DEPLOY_USER=root

# SSH port. Set to 22 unless your provider uses something else.
DEPLOY_PORT=22

# Directory on the VPS to deploy into. Must be writable by DEPLOY_USER, since
# rsync is unprivileged — "~" is resolved to the remote home directory.
DEPLOY_PATH=~/neko-farm

# How to escalate on the VPS for docker. Set to empty if the user is already root
# or in the docker group. Example: DEPLOY_SUDO=sudo
DEPLOY_SUDO=sudo

# Public hostname served by the existing cloudflared tunnel. Informational —
# the script prints it at the end, it does not configure Cloudflare.
PUBLIC_HOSTNAME=watch.example.com
