# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Neko login password (regular user) and admin password (separate value).
# Generate: openssl rand -base64 18 | tr -d '/+=' | head -c 20
NEKO_PASSWORD=
NEKO_PASSWORD_ADMIN=

# VPS public IP, advertised to the browser for direct WebRTC media.
# The deploy script sets this from DEPLOY_HOST in deploy.env automatically.
VPS_PUBLIC_IP=
